{
  "name": "mini-ecommerce-distribuido",
  "version": "1.0.0",
  "description": "Mini e-commerce distribuído com microserviços, API Gateway, JWT, replicação e heartbeat.",
  "main": "index.js",
  "scripts": {
    "users": "nodemon users/server.js",
    "products": "nodemon products/server.js",
    "orders": "nodemon orders/server.js",
    "gateway": "nodemon gateway/server.js",
    "dev": "concurrently \"npm run users\" \"npm run products\" \"npm run orders\" \"npm run gateway\"",
    "start": "concurrently \"node users/server.js\" \"node products/server.js\" \"node orders/server.js\" \"node gateway/server.js\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "keywords": [
    "microservices",
    "api-gateway",
    "jwt",
    "ecommerce"
  ],
  "author": "Bruno Mayer",
  "license": "MIT"
}